# Optional local-only integration. Never commit a real .env file.
# Copy to .env.local to try read-only DhanHQ against your own account.
# These are read on the server only; never add a NEXT_PUBLIC_ prefix.
DHAN_READ_ONLY_ENABLED=false
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_API_BASE_URL=https://api.dhan.co/v2

# Optional future event provider; no provider is integrated in V1 (these are not read yet).
EVENT_PROVIDER=demo
EVENT_PROVIDER_API_KEY=
